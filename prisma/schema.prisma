generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  gridSlots     GridSlot[]
  userGrid      UserGrid?
  contents      Content[]
  quickLinks    QuickLink[]
  orders        ClothingOrder[]
  deletedSlots  DeletedFeedSlot[]
  googleCalendar GoogleCalendarLink?
  calendarEvents CalendarEvent[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
model UserGrid {
  id          String @id @default(cuid())
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemsData   String // JSON stringified array of SlotItem
  profileData String? // JSON stringified profile data
  updatedAt   DateTime @default(now()) @updatedAt
}

model GridSlot {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Int // 0-8 for the 3x3 grid
  type     String // "image" | "placeholder"

  metadata PostMetadata?
  media    Media?

  @@unique([userId, position])
}

model PostMetadata {
  id         String   @id @default(cuid())
  gridSlotId String   @unique
  gridSlot   GridSlot @relation(fields: [gridSlotId], references: [id], onDelete: Cascade)

  caption       String?
  audioTrack    String?
  contentType   String? // "Post", "Reel", "Carousel", "Story"
  scheduledTime DateTime?
}

model Media {
  id         String   @id @default(cuid())
  gridSlotId String   @unique
  gridSlot   GridSlot @relation(fields: [gridSlotId], references: [id], onDelete: Cascade)

  url         String?
  hexColor    String? @default("#fdfbfb") // soft pastel white default
  overlayText String?
}

// Content planner (recreation of the Notion content workflow)
model Content {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One parent maximum; e.g. "BATCH A" -> "Notion Box", "Clark Date"
  parentId String?
  parent   Content?  @relation("ContentBatch", fields: [parentId], references: [id], onDelete: SetNull)
  children Content[] @relation("ContentBatch")

  title          String
  status         String   @default("To Board")
  categories     String[] @default([])
  edited         Boolean  @default(false)
  clothingStatus String?
  orderedAt      DateTime? // set when clothing moves to "Ordered"
  deliveredAt    DateTime? // set when clothing moves to "Delivered"; starts the 14-day return window

  // SHEIN order this batch belongs to (one order covers two batches)
  orderId String?
  order   ClothingOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Wall-clock values in Asia/Manila: "YYYY-MM-DD" or "YYYY-MM-DDTHH:mm" (no timezone shifts)
  shootStart String?
  shootEnd   String?
  editStart  String?
  editEnd    String?
  postStart  String? // "Post Now": a planned posting date, never a publishing action
  postEnd    String?

  pinterestUrl String?
  location     Json? // { name, address, latitude, longitude, placeId }
  body         String  @default("")

  // Link back to the feed slot that created this entry
  slotId      String?
  contentType String?
  // More feed boxes for the same page when it's in several places, e.g. { "StoryFolder": "slot-…" }
  extraSlots  Json?
  media       ContentMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slotId])
  @@index([userId, parentId])
}

model ContentMedia {
  id        String  @id @default(cuid())
  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  url       String // remote URL or local-media://<id> reference into the browser's media store
  position  Int     @default(0)

  @@index([contentId])
}

model QuickLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  text      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

// One SHEIN order covers two batches; its 14-day return window starts on delivery.
model ClothingOrder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  orderedAt   DateTime?
  deliveredAt DateTime?
  returnedAt  DateTime?
  createdAt   DateTime  @default(now())
  batches     Content[]

  @@index([userId])
}

// Feed boxes deleted on either side, so every browser's feed and the database stay in step.
model DeletedFeedSlot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId    String
  deletedAt DateTime @default(now())

  @@unique([userId, slotId])
}

// Google Calendar connection: shoot/edit/post dates (and SHEIN deadlines) mirrored as events with reminders,
// in a calendar the app creates ("IG Curator"). The refresh token is stored encrypted.
model GoogleCalendarLink {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String // encrypted
  calendarId   String?
  lastSyncedAt DateTime?
  lastError    String?
  syncToken    String? // to ask Google only for events changed since the last sync
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CalendarEvent {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String // "<content or order id>:<shoot|edit|post|order|return>"
  googleEventId String
  hash          String // what was last sent, to skip unchanged events
  start         String? // the time last sent (Asia/Manila "YYYY-MM-DDTHH:mm"), to notice events moved in Google
  end           String?

  @@unique([userId, key])
}
